{
  "name": "my-suitcase",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "translate": "ng extract-i18n",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start-es": "ng serve --proxy-config proxy.conf.json --configuration=es-ES",
    "start-prod": "ng build --configuration=production --localize",
    "start-prod-local": "ng build --configuration=production --localize && http-server -c-1 -p 8080 dist/my-suitcase/",
    "start-github-pages": "ng build --configuration=production --localize --output-path docs --base-href /mySuitcase/",
    "test": "ng test",
    "posttest": "node -e 'console.log(\"Testing done!\")'",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@angular/material": "^22.0.6",
    "@angular/material-moment-adapter": "^22.1.1",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-browser-dynamic": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/service-worker": "^16.1.4",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "g": "^2.0.1",
    "moment": "^2.30.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.0.0",
    "uuid": "^14.0.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.8",
    "@angular-eslint/builder": "^15.2.1",
    "@angular-eslint/eslint-plugin": "^16.0.3",
    "@angular-eslint/eslint-plugin-template": "^16.0.3",
    "@angular-eslint/template-parser": "^16.0.3",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@angular/language-service": "^22.0.8",
    "@eslint/js": "^10.0.1",
    "@types/google.maps": "^3.65.4",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-config-standard-with-typescript": "^36.0.0",
    "eslint-config-xo": "^0.43.1",
    "eslint-config-xo-typescript": "^0.57.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsdoc": "^46.4.3",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-promise": "^6.1.1",
    "http-server": "^14.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
